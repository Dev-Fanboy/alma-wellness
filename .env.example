# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Expo Project ID (for push notifications)
# Get from app.json > extra > eas > projectId or EAS dashboard
EXPO_PUBLIC_PROJECT_ID=your-project-id-here
